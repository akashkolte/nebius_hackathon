# Copy to .env and fill in. .env is never committed. `npm start` and Docker both read it.

# Your Nebius Token Factory API key.
NEBIUS_API_KEY=
# The password you sign in with (8+ characters).
DISPATCH_PASSWORD=k91Pz!vL2$

# Demo mode: a sample project, example tasks, and approval for every shell command.
DISPATCH_DEMO=1
# Offer only the Nebius agent, not Claude Code or Codex sessions found on this computer.
DISPATCH_CLI=0

# Only for hosting on a server with docker compose (see docs/DEPLOY.md).
# Public hostname for HTTPS, e.g. 203-0-113-10.sslip.io for IP 203.0.113.10.
DISPATCH_DOMAIN=
DISPATCH_MAX_TASKS_PER_HOUR=30
DISPATCH_MAX_CONCURRENT=3
