# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
# Password judges use to sign in (8+ characters). Put it in your submission.
DISPATCH_PASSWORD=
# Public hostname for HTTPS. Without your own domain, use the VM's IP with dashes + .sslip.io,
# e.g. 203-0-113-10.sslip.io for IP 203.0.113.10.
DISPATCH_DOMAIN=
# Optional limits for the shared demo.
DISPATCH_MAX_TASKS_PER_HOUR=30
DISPATCH_MAX_CONCURRENT=3
