{
  "name": "dispatch-nebius",
  "version": "0.1.0",
  "description": "A browser and phone task plane for coding agents, routed and powered by Nebius Token Factory.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
